<Window x:Class="BacpacExplorer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BacpacExplorer.App.Localization"
        Title="{loc:Loc WindowTitle}" Height="760" Width="1240"
        MinHeight="560" MinWidth="900" Closed="MainWindow_Closed">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <DockPanel>
                <Button x:Name="OpenButton" Content="{loc:Loc OpenBacpac}" Padding="18,8" Click="OpenButton_Click" />
                <Button x:Name="PrepareDataButton" Content="{loc:Loc LoadDatabaseData}" Padding="18,8" Margin="8,0,0,0"
                        IsEnabled="False" Click="PrepareDataButton_Click" />
                <TextBlock x:Name="FileText" Margin="14,0,0,0" VerticalAlignment="Center"
                           Text="{loc:Loc NoFileLoaded}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <Border Margin="0,10,0,0" Padding="10,7" Background="#F3F5F7" BorderBrush="#D8DDE2" BorderThickness="1">
                <TextBlock x:Name="DatabaseSummaryText" Foreground="#444" Text="{loc:Loc NoDatabaseLoaded}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </StackPanel>

        <TabControl x:Name="WorkspaceTabs" Grid.Row="2">
            <TabItem Header="{loc:Loc Explorer}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="8">
                        <DockPanel>
                            <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                                     ToolTip="{loc:Loc FilterTables}" TextChanged="FilterBox_TextChanged" />
                            <TreeView x:Name="DatabaseTree" SelectedItemChanged="DatabaseTree_SelectedItemChanged" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="SelectionTitle" FontSize="22" FontWeight="SemiBold" Text="{loc:Loc OpenBacpacPrompt}" />
                                <TextBlock x:Name="SelectionSubtitle" Margin="0,4,0,0" Foreground="#666"
                                           Text="{loc:Loc TableInformationPrompt}" />
                            </StackPanel>

                            <TabControl x:Name="DetailsTabs" Grid.Row="2" SelectionChanged="DetailsTabs_SelectionChanged">
                                <TabItem Header="{loc:Loc Columns}">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DataGrid x:Name="ColumnsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="All"
                                                  HorizontalGridLinesBrush="#D0D0D0" VerticalGridLinesBrush="#D0D0D0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Loc Column}" Binding="{Binding Name}" Width="2*" />
                                                <DataGridTextColumn Header="{loc:Loc SqlType}" Binding="{Binding SqlType}" Width="*" />
                                                <DataGridTextColumn Header="{loc:Loc Nullability}" Binding="{Binding Nullability}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock x:Name="DetailsText" Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center"
                                                   Foreground="#666" TextWrapping="Wrap" />
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="DataTab" Header="{loc:Loc Data}">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <TextBlock Text="{loc:Loc RowsPerPage}" VerticalAlignment="Center" />
                                                <ComboBox x:Name="PageSizeBox" Width="78" Margin="8,0,0,0" SelectedIndex="1">
                                                    <ComboBoxItem Content="50" />
                                                    <ComboBoxItem Content="100" />
                                                    <ComboBoxItem Content="250" />
                                                    <ComboBoxItem Content="500" />
                                                </ComboBox>
                                            </StackPanel>
                                            <TextBlock x:Name="PageText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="#666" Text="{loc:Loc NoDataLoaded}" />
                                        </DockPanel>
                                        <DataGrid x:Name="RowsGrid" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True"
                                                  CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True"
                                                  EnableColumnVirtualization="True" HeadersVisibility="Column" GridLinesVisibility="All"
                                                  HorizontalGridLinesBrush="#C8C8C8" VerticalGridLinesBrush="#C8C8C8"
                                                  RowHeight="28" CanUserResizeRows="False" SelectionUnit="Cell" SelectionMode="Single"
                                                  SelectedCellsChanged="RowsGrid_SelectedCellsChanged"
                                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                  VirtualizingPanel.ScrollUnit="Pixel" />
                                        <Expander Grid.Row="3" Margin="0,10,0,0" IsExpanded="True">
                                            <Expander.Header>
                                                <TextBlock x:Name="SelectedCellLabel" Text="{loc:Loc SelectedCellValue}" FontWeight="SemiBold" />
                                            </Expander.Header>
                                            <TextBox x:Name="SelectedCellText" Margin="0,6,0,0" MinHeight="72" MaxHeight="150"
                                                     IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                     Text="{loc:Loc SelectCellPrompt}" />
                                        </Expander>
                                        <DockPanel Grid.Row="4" Margin="0,10,0,0">
                                            <Button x:Name="PreviousButton" Content="{loc:Loc Previous}" Padding="14,6" IsEnabled="False"
                                                    Click="PreviousButton_Click" />
                                            <Button x:Name="NextButton" Content="{loc:Loc Next}" Padding="14,6" Margin="8,0,0,0"
                                                    IsEnabled="False" Click="NextButton_Click" />
                                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#666"
                                                       Text="{loc:Loc PagingNotice}" />
                                        </DockPanel>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Loc Query}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="225" MinHeight="110" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="QueryEditor" FontFamily="Consolas" FontSize="14" AcceptsReturn="True" AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Text="{loc:Loc DefaultQuery}" />
                        <DockPanel Grid.Row="1" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button x:Name="ExecuteQueryButton" Content="{loc:Loc Execute}" Padding="18,7" IsEnabled="False"
                                        Click="ExecuteQueryButton_Click" />
                                <Button x:Name="CancelQueryButton" Content="{loc:Loc Cancel}" Padding="18,7" Margin="8,0,0,0"
                                        IsEnabled="False" Click="CancelQueryButton_Click" />
                                <Button x:Name="QuerySelectedTableButton" Content="{loc:Loc QuerySelectedTable}" Padding="18,7"
                                        Margin="8,0,0,0" IsEnabled="False" Click="QuerySelectedTableButton_Click" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#666"
                                       Text="{loc:Loc QueryLimits}" />
                        </DockPanel>
                    </Grid>

                    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#D8DDE2"
                                  ShowsPreview="True" ToolTip="{loc:Loc ResizeQueryToolTip}" />

                    <DataGrid x:Name="QueryResultsGrid" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True"
                              EnableColumnVirtualization="True" HeadersVisibility="Column" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#C8C8C8" VerticalGridLinesBrush="#C8C8C8"
                              RowHeight="28" CanUserResizeRows="False" SelectionUnit="Cell" SelectionMode="Single"
                              SelectedCellsChanged="QueryResultsGrid_SelectedCellsChanged"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel" />

                    <Expander Grid.Row="3" Margin="0,10,0,0" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock x:Name="QueryCellLabel" Text="{loc:Loc SelectedResultValue}" FontWeight="SemiBold" />
                        </Expander.Header>
                        <TextBox x:Name="QueryCellText" Margin="0,6,0,0" MinHeight="64" MaxHeight="130"
                                 IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Text="{loc:Loc SelectResultCellPrompt}" />
                    </Expander>

                    <Expander Grid.Row="4" Margin="0,8,0,0" Header="{loc:Loc Messages}" IsExpanded="True">
                        <TextBox x:Name="QueryMessagesText" Margin="0,6,0,0" MinHeight="52" MaxHeight="100"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="{loc:Loc QueryInitialMessage}" />
                    </Expander>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="3" Margin="0,10,0,0">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="{loc:Loc Ready}" /></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
